<div class="cart">
  <div class="product"></div>
  <div class="addres">
    <form>
      <h2>Informacion de envio</h2>
      <p>
        Al confirmar tu pedido, nuestro gremio se comunicará contigo para
        calcular los costos de la travesía y acordar el pago
      </p>

      <label for="addres">Direccion</label>
      <input type="text" id="addres" placeholder="e.j: Manzana J, Casa 10" />
      <label for="phone">Telefono</label>
      <input type="number" id="phone" placeholder="e.j: 315...." />
      <div class="city">
        <div class="box">
          <label for="municipality">Municipio</label>
          <input type="text" id="municipality" placeholder="e.j: Santander" />
          <label for="city">Ciudad</label>
          <input type="text" id="city" placeholder="e.j: Bucaramanga" />
        </div>
        <div class="box">
          <label for="type">Tipo</label>
          <input type="text" id="type" placeholder="e.j: Casa" />
          <label for="inf">Informacion adicional</label>
          <textarea
            id="inf"
            placeholder="ej: dejar en portería, casa con reja negra"></textarea>
        </div>

      </div>
      
    </form>

    <button class="btn-submit">Hacer pedido</button>
  </div>
</div>

<script>
  import { getProductosCarrito } from "../services/cartServices";
  import { onAuthStateChanged } from "firebase/auth";
  import { auth } from "../firebase";
  import { crearPedido, deleteProduct } from "../services/createOrderService";

  const cart = document.querySelector(".product");
  const btnSubmitOrder = document.querySelector(".btn-submit");

  onAuthStateChanged(auth, (user) => {
    if (user) {
      const userID = user.uid;
      getProductosCarrito(cart, userID);

      btnSubmitOrder?.addEventListener("click", async (e) => {
        e.preventDefault();
        try {
          const addres = document.getElementById("addres").value.trim();
          const municipality = document.getElementById("municipality").value.trim();
          const city = document.getElementById("city").value.trim();
          const type = document.getElementById("type").value.trim();
          const inf = document.getElementById("inf").value.trim();
          const phone = document.getElementById("phone").value.trim();

          if (!addres || !municipality || !city) {
            alert(
              "Por favor completa al menos la dirección, el municipio y la ciudad.",
            );
            return;
          }

          const OrderData = {
            Direccion: addres,
            Municipio: municipality,
            Ciudad: city,
            Tipo: type,
            Descripcion: inf,
            Celular: phone,
          };

          const result = await crearPedido(userID, OrderData)

          document.querySelector("form").reset()

          deleteProduct(userID)
          getProductosCarrito(cart, userID);
        } catch {
          console.log("No se puede crear el pedido");
        }
      });


    } else {
      if (cart) {
        cart.innerHTML = `
        <div class="text-center py-12">
          <p class="text-gray-400 italic">Por favor, inicia sesión para ver tu carrito.</p>
        </div>
      `;
      }
    }
  });
</script>
