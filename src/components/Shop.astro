<div class="cart"></div>

<script>
    import { getProductosCarrito } from "../services/cartServices";
    import { onAuthStateChanged } from "firebase/auth";
    import { auth } from "../firebase";

    const cart = document.querySelector(".cart")


    onAuthStateChanged(auth, (user) => {
  if (user) {
    console.log(user.uid)
    const userID = user.uid
    // ¡El usuario ya está validado y activo! Cargamos sus productos
    getProductosCarrito(cart, userID);
  } else {
    // Si no hay usuario, mostramos de forma segura el mensaje en el DOM
    if (cart) {
      cart.innerHTML = `
        <div class="text-center py-12">
          <p class="text-gray-400 italic">Por favor, inicia sesión para ver tu carrito.</p>
        </div>
      `;
    }
  }
});
</script>



