---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/navigation.astro";
import Mayor from "../components/Mayor.astro";
import Contact from "../components/contact.astro";
import "../css/index.css";
---

<Layout>
  <Mayor />
  <section class="hero">
    <div class="overlay"></div>
    <Navigation />
    <div class="content">
      <h1>Siente la Fuerza de Nuestra Tierra en cada Sorbo</h1>
      <a href="/Productos" class="tasty">Probar ahora</a>
    </div>
  </section>

  <section class="about">
    <div class="content">
      <div class="part_1">
        <h2>Nuestra historia, tu sabor</h2>
      </div>
      <div class="part_2">
        <div class="box">
          <p>
            Creemos que la perfección no se apresura, se cultiva. Nuestra
            historia es el resultado de años perfeccionando la alquimia entre el
            agua más pura y granos seleccionados con rigor. Al unir nuestra
            herencia artesanal con tu paladar, creamos un equilibrio perfecto
            donde el pasado y el presente se encuentran. Un sabor diseñado para
            quienes saben que los mejores relatos se cuentan frente a una buena
            copa.
          </p>
        </div>
        <div class="box">
          <img src="./bottle.png" alt="Cerveza Negra" class="bottle" />
        </div>
        <div class="box box_3">
          <img src="./sello.png" alt="" class="poster" />
        </div>
      </div>
    </div>
  </section>

  <section class="information">
    <div class="content">
      <div class="info">
        <h2>Guanerita Negra</h2>
        <p>
          Una alquimia perfecta de maltas tostadas con notas profundas a café y
          chocolate amargo. Forjada con la paciencia que solo nuestra tierra
          santandereana sabe dar.
        </p>
      </div>

      <div class="data">
        <div class="line">
          <h3>Alcohol: 8.5% Vol.</h3>
        </div>
        <div class="line">
          <h3>IBU: 45 (Amargor Medio)</h3>
        </div>
        <div class="line">
          <h3>Cuerpo: Robusto y Cremoso</h3>
        </div>
      </div>
    </div>
  </section>

  <div class="counter">
    <div class="backgroundCounter">
      <div class="boxCounter box_after_1">
        <img src="./miel.webp" alt="Miel">
      </div>
      <div class="boxCounter box_after_2">
        <img src="./cafe.webp" alt="Café">
      </div>
      <div class="boxCounter box_after_3">
        <img src="./trigo.webp" alt="Trigo">
      </div>
    </div>
  </div>
  <div class="reference">
    <div class="content">
      <div class="part_1">
        <img src="./materia_prima_.png" alt="">

        <article>
          <h2>El Ritual Detrás del Cáliz</h2>
          <p>No existen fórmulas mágicas, solo el respeto absoluto por el tiempo y la materia prima. Desde la selección manual de los granos hasta el control exacto de cada grado Brix, desvelamos los secretos que convierten el agua y la cebada en la fuerza de nuestra tierra.</p>
        </article>
      </div>
    </div>
  </div>

  <Contact />
  <script>
  const ok = document.querySelector(".yes");
  const mayor = document.querySelector(".mayor");
  const body = document.querySelector(".body");

  if (ok && mayor) {
    ok.addEventListener("click", () => {
      mayor.classList.add("ocultar");
      if (body) body.classList.remove("hidden");
    });
  }

  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("load", () => {
    // Creamos el validador de medios de GSAP
    let mm = gsap.matchMedia();

    // 💻 CONDICIÓN PARA PC (Pantallas mayores a 1200px)
    mm.add("(min-width: 1201px)", () => {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: ".about", 
          start: "top bottom", 
          end: "top top",      
          scrub: 1,        
        }
      });

      tl.to(".hero", {
        opacity: 0,
        y: -100,
        duration: 1
      }, 0);

      tl.fromTo(".about", 
        { y: 300, opacity: 0 }, 
        { y: 0, opacity: 1, duration: 1 }, 
        0
      );

      // la seccion sube y aparece
      tl.from(".about .part_1, .about .box:not(:has(.bottle))", {
        y: 50,
        opacity: 0,
        stagger: 0.2,
        duration: 0.5
      });

      // la botella baja (ESTO YA NO SE EJECUTARÁ EN MÓVIL)
      tl.to(".bottle", {
        y: 450, 
        ease: "power1.inOut",
        duration: 2 
      });

      // sello animacion
      tl.fromTo(".poster", 
        { scale: 0, opacity: 0 }, 
        { scale: 1, opacity: 0.35, duration: 0.6, ease: "back.out(1.5)" }, 
        "-=1.5"
      );
    });

    // 📱 ANIMACIONES PARA TODO DISPOSITIVO (Se ejecutan en Móvil y PC)
    // Animación de los ingredientes (.counter)
    gsap.to(".boxCounter img", {
      clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
      ease: "power2.out",
      duration: 1.5,
      stagger: 0.3, 
      scrollTrigger: {
        trigger: ".counter",        
        start: "top 90%",           
        end: "bottom 100%",
        scrub: 1,                   
      }
    });

    

    // Animación de El Ritual Detrás del Cáliz (.reference)
    const tlRitual = gsap.timeline({
      scrollTrigger: {
        trigger: ".reference",       
        start: "top 75%",            
        end: "top 30%",              
        scrub: 1,                    
      }
    });

    tlRitual.from(".reference .part_1 img", {
      x: -60,
      opacity: 0,
      duration: 1.2,
      ease: "power2.out"
    }, 0);

    tlRitual.from(".reference .part_1 article", {
      x: 60,
      opacity: 0,
      duration: 1.2,
      ease: "power2.out"
    }, 0);

    tlRitual.from(".reference h2", {
      y: 20,
      opacity: 0,
      duration: 0.6,
      ease: "power1.out"
    }, 0.4);

    tlRitual.from(".reference p", {
      y: 20,
      opacity: 0,
      duration: 0.8,
      ease: "power1.out"
    }, 0.6);

  }); // Cierre del window load
</script>
</Layout>
