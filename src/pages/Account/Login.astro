---
import Layout from "../../layouts/Layout.astro";
import "../../css/Login.css";
---

<Layout>
  <div class="login">
    <a href="/" class="guanerita">Guanerita</a>
    <div class="background">
      <img src="../lupulo.png" alt="" class="pattern" />
      <img src="../lupulo_hoja.png" class="up" />
      <h1>¡Bienvenidos a Guanerita!</h1>
      <p>
        Inicia sesión para descubrir el verdadero sabor de nuestra cerveza
        artesanal premium.
      </p>
      <img src="../lupulo_hoja.png" class="down" />
    </div>
    <div class="content">
      <div class="form">
        <h2>Destapar Experiencia</h2>
        <h4>Inicia sesion con</h4>
        <div class="box_form">
          <button class="google" id="btn-google">
            <img src="../google.svg" alt="Google" />
          </button>
          <button class="google" id="btn-github">
            <img src="../github_light.svg" alt="Google" />
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { authService } from "../../services/authServices.js";

    // Manejador de Google
    document
      .getElementById("btn-google")
      ?.addEventListener("click", async () => {
        try {
          const user = await authService.loginWithGoogle();
          console.log("¡Logueado con éxito!", user);
          window.location.href = '/'
        } catch (error) {
          alert("Error al iniciar sesión con Google");
        }
      });

    // Manejador de GitHub
    document
      .getElementById("btn-github")
      ?.addEventListener("click", async () => {
        try {
          const user = await authService.loginWithGithub();
          console.log("¡Logueado con GitHub!", user);
          window.location.href = '/'
        } catch (error) {
          alert("Error al iniciar sesión con GitHub");
        }
      });

    // Manejador de Apple
    document
      .getElementById("btn-apple")
      ?.addEventListener("click", async () => {
        try {
          const user = await authService.loginWithApple();
          console.log("¡Logueado con Apple!", user);
        } catch (error) {
          alert("Error al iniciar sesión con Apple");
        }
      });
  </script>
</Layout>
