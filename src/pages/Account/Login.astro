---
import Layout from "../../layouts/Layout.astro";
import "../../css/Login.css";
---

<Layout>
    <div class="login">
        <div class="background">
            <img src="../lupulo.png" alt="" class="pattern">
            <img src="../lupulo_hoja.png" class="up">
            <h1>¡Bienvenidos a Guanerita!</h1>
  <p>Inicia sesión para descubrir el verdadero sabor de nuestra cerveza artesanal premium.</p>
            <img src="../lupulo_hoja.png" class="down">
        </div>
        <div class="content">
            <form>
                <h2>Destapar Experiencia</h2>
                <div class="inputs">
                    <label for="">Correo</label>
                    <input type="email" name="" id="">
                </div>
                <div class="inputs">
                    <label for="">Contraseña</label>
                    <input type="password" name="" id="">
                </div>

                <button>Entrar a la Comunidad</button>
            </form>
        </div>
    </div>
</Layout>